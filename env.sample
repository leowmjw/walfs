# Tigris Object Storage Configuration
# Copy this file to .env and fill in your actual credentials
# Get your Tigris credentials from: https://console.tigris.dev/

# Tigris Endpoint
# - For Fly.io hosted apps: https://fly.storage.tigris.dev
# - For external access: https://t3.storage.dev
TIGRIS_ENDPOINT=https://fly.storage.tigris.dev

# Tigris Access Credentials
# Get these from your Tigris dashboard
TIGRIS_ACCESS_KEY_ID=your_access_key_id_here
TIGRIS_SECRET_ACCESS_KEY=your_secret_access_key_here

# Bucket Configuration
# The bucket must already exist in your Tigris account
TIGRIS_BUCKET_NAME=your_bucket_name_here

# Optional: Prefix for WAL segments in the bucket
# Default: walfs/basic/
TIGRIS_PREFIX=walfs/basic/

# Optional: AWS Region (typically "auto" for Tigris)
# Default: auto
TIGRIS_REGION=auto
